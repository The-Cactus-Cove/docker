TZ="America/Phoenix"

# APP_KEY must be a unique key. Generate your own by running
# docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:latest appkey
# You should keep the "base64:" part for the option value.
BOOKSTACK_APP_KEY=
BOOKSTACK_DB_PASSWORD=
BOOKSTACK_OIDC_CLIENT_ID=
BOOKSTACK_OIDC_CLIENT_SECRET=

HBOX_AUTH_API_KEY_PEPPER=
HBOX_OIDC_CLIENT_ID=
HBOX_OIDC_CLIENT_SECRET=

VIKUNJA_DATABASE_PASSWORD=
VIKUNJA_SERVICE_SECRET=
VIKUNJA_AUTH_OPENID_PROVIDERS_POCKETID_CLIENTID=
VIKUNJA_AUTH_OPENID_PROVIDERS_POCKETID_CLIENTSECRET=

# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
HOMELABLE_SECRET_KEY=
# Set this to the URL(s) you use to access Homelable in your browser.
HOMELABLE_CORS_ORIGINS=["http://localhost:5173","http://localhost:3067"]
HOMELABLE_AUTH_MODE=oidc
HOMELABLE_OIDC_DISCOVERY_URL=https://auth.cactuscove.casa/.well-known/openid-configuration
HOMELABLE_OIDC_CLIENT_ID=
HOMELABLE_OIDC_CLIENT_SECRET=
HOMELABLE_OIDC_REDIRECT_URI=https://homelable.cactuscove.casa/api/v1/auth/oidc/callback
HOMELABLE_OIDC_SCOPES="openid profile email"
HOMELABLE_OIDC_COOKIE_SECURE=true
HOMELABLE_OIDC_SESSION_EXPIRE_MINUTES=480
HOMELABLE_OIDC_TRANSACTION_EXPIRE_SECONDS=600

# Scanner — JSON array of CIDR ranges to scan
HOMELABLE_SCANNER_RANGES=["192.168.1.0/24"]

# MCP server — used by the mcp service (port 8001)
# MCP_API_KEY: authenticates AI clients (Claude Code, etc.) → MCP server
# MCP_SERVICE_KEY: authenticates MCP server → backend (never exposed externally)
# Generate keys: python3 -c "import secrets; print(secrets.token_hex(32))"
HOMELABLE_MCP_API_KEY=
HOMELABLE_MCP_SERVICE_KEY=

# Z-Wave JS UI (zwavejs2mqtt) auto-sync — same MQTT secret/env rules as Zigbee.
HOMELABLE_ZWAVE_MQTT_HOST=mosquitto
HOMELABLE_ZWAVE_MQTT_PORT=1883
# ZWAVE_MQTT_USERNAME=mqttuser         # optional
# ZWAVE_MQTT_PASSWORD=mqttpass         # optional
HOMELABLE_ZWAVE_PREFIX=zwave
HOMELABLE_ZWAVE_GATEWAY_NAME=zwavejs
HOMELABLE_ZWAVE_MQTT_TLS=false                 # true for TLS brokers (typically port 8883)
HOMELABLE_ZWAVE_MQTT_TLS_INSECURE=false        # skip cert verify (self-signed only; requires TLS)
# Seconds to wait for the gateway to answer an MQTT request. Same rationale as
# ZIGBEE_NETWORKMAP_TIMEOUT above.
HOMELABLE_MQTT_RESPONSE_TIMEOUT=300
